# PostgreSQL Database Configuration for AWS Barangay Management System
# Copy these values to your .env file

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=barangay_management
DB_USERNAME=barangay_user
DB_PASSWORD=secure_password_here

# PostgreSQL Specific Settings
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Optional: Performance and Connection Settings
DB_TIMEOUT=60
DB_PERSISTENT=false
DB_DISABLE_PREPARES=false

# For AWS RDS (if deploying to AWS later)
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_SSLMODE=require
# DB_USERNAME=your_rds_username
# DB_PASSWORD=your_rds_password
