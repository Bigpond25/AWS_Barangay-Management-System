# Environment Configuration for PostgreSQL (AWS RDS Ready)

# Basic Laravel Configuration
APP_NAME="Barangay Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=barangay_management
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=require

# For AWS RDS (production)
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_USERNAME=your_rds_username
# DB_PASSWORD=your_rds_password
# DB_SSLMODE=require

# Optional PostgreSQL optimizations
DB_DISABLE_PREPARES=false
DB_TIMEOUT=60
DB_PERSISTENT=false

# Cache Configuration (Redis recommended for production)
CACHE_STORE=database
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Session & Queue
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Mail Configuration
MAIL_MAILER=log
